{
  "Version":"2012-10-17",
  "Statement":[
    {"Sid":"ReadDestinationSecurity","Effect":"Allow","Action":["s3:GetBucketLocation","s3:GetBucketPublicAccessBlock","s3:GetBucketOwnershipControls","s3:GetEncryptionConfiguration","s3:GetBucketPolicyStatus"],"Resource":"arn:aws:s3:::diagram-design-system-676643701781-apne1"},
