    {"Sid":"ReadLibraryArtifacts","Effect":"Allow","Action":"s3:GetObject","Resource":["arn:aws:s3:::diagram-design-system-676643701781-apne1/library/diagrams/*","arn:aws:s3:::diagram-design-system-676643701781-apne1/library/catalog/*"]},
    {"Sid":"CreateImmutableEncryptedArtifacts","Effect":"Allow","Action":"s3:PutObject","Resource":["arn:aws:s3:::diagram-design-system-676643701781-apne1/library/diagrams/*","arn:aws:s3:::diagram-design-system-676643701781-apne1/library/catalog/*"],"Condition":{"StringEquals":{"s3:x-amz-server-side-encryption":"AES256"},"Null":{"s3:if-none-match":"false"}}}
  ]
