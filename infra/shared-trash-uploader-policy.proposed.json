{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::diagram-design-system-676643701781-apne1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "library/lifecycle/*",
            "library/state/*",
            "library/document-locks/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::diagram-design-system-676643701781-apne1/library/lifecycle/*",
        "arn:aws:s3:::diagram-design-system-676643701781-apne1/library/state/*",
        "arn:aws:s3:::diagram-design-system-676643701781-apne1/library/document-locks/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::diagram-design-system-676643701781-apne1/library/document-locks/*"
    }
  ]
}
