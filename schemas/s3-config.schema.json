{
  "$schema":"http://json-schema.org/draft-07/schema#", "$id":"urn:diagram-design-system:s3-config:1",
  "type":"object", "additionalProperties":false,
  "required":["schemaVersion","bucket","region","expectedBucketOwner","prefix","encryption","approved"],
  "properties":{
    "schemaVersion":{"const":"1.0"},
    "bucket":{"type":"string","minLength":3,"maxLength":63,"pattern":"^[a-z0-9][a-z0-9-]*[a-z0-9]$"},
    "region":{"const":"ap-northeast-1"},
    "expectedBucketOwner":{"type":"string","pattern":"^[0-9]{12}$"},
    "prefix":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,62}$"},
    "encryption":{"const":"AES256"},
    "approved":{"type":"boolean"},
    "maxVersions":{"type":"integer","minimum":1,"maximum":10},
    "profile":{"type":"string","minLength":1,"maxLength":128}
  }
}
