{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:diagram-design-system:metadata:1",
  "title": "Immutable diagram version and catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "diagramId",
    "title",
    "diagramType",
    "createdAt",
    "updatedAt",
    "version",
    "outputFormats",
    "storage",
    "files",
    "preview",
    "validation",
    "metadataKey",
    "catalogKey"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "diagramId": {
      "$ref": "#/definitions/uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "diagramType": {
      "enum": [
        "roadmap",
        "flowchart",
        "architecture",
        "comparison"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "outputFormats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "svg",
          "png"
        ]
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "region",
        "expectedBucketOwner",
        "prefix",
        "encryption"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 3
        },
        "region": {
          "const": "ap-northeast-1"
        },
        "expectedBucketOwner": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "encryption": {
          "const": "AES256"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "format",
          "contentType",
          "sizeBytes",
          "sha256",
          "key"
        ],
        "properties": {
          "name": {
            "enum": [
              "diagram.svg",
              "diagram.png",
              "input.json",
              "validation.json"
            ]
          },
          "role": {
            "enum": [
              "source",
              "preview",
              "input",
              "validation"
            ]
          },
          "format": {
            "enum": [
              "svg",
              "png",
              "json"
            ]
          },
          "contentType": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "key": {
            "$ref": "#/definitions/key"
          }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "key"
      ],
      "properties": {
        "fileName": {
          "const": "diagram.png"
        },
        "key": {
          "$ref": "#/definitions/key"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "key",
        "checks"
      ],
      "properties": {
        "fileName": {
          "const": "validation.json"
        },
        "key": {
          "$ref": "#/definitions/key"
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "合格",
              "不合格",
              "未検証",
              "対象外"
            ]
          }
        }
      }
    },
    "metadataKey": {
      "$ref": "#/definitions/key"
    },
    "catalogKey": {
      "$ref": "#/definitions/key"
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "key": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[a-z0-9][a-z0-9-]*/(diagrams|catalog)/[a-f0-9-]+/versions/[0-9]{6}/[A-Za-z0-9.-]+$"
    }
  },
  "$comment": "Legacy Phase 3 metadata 1.0. Full-format package design uses metadata-package.schema.json (2.0); current uploader does not support 2.0."
}
