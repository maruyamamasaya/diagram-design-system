{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:diagram-design-system:diagram:1",
  "title": "Roadmap semantic input v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "type", "title", "purpose", "audience", "notes", "steps", "relations"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "type": {"const": "roadmap"},
    "title": {"$ref": "#/definitions/text"},
    "purpose": {"$ref": "#/definitions/text"},
    "audience": {"$ref": "#/definitions/text"},
    "notes": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/definitions/text"}},
    "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "reference"], "properties": {"label": {"$ref": "#/definitions/text"}, "reference": {"$ref": "#/definitions/text"}}}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 4, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "purpose", "items"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "title": {"$ref": "#/definitions/text"},
        "purpose": {"$ref": "#/definitions/text"},
        "items": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["text", "kind"], "properties": {"text": {"$ref": "#/definitions/text"}, "kind": {"enum": ["text", "code"]}}}},
        "outcome": {"$ref": "#/definitions/text"}
      }
    }},
    "relations": {"type": "array", "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "kind", "label", "basis"],
      "properties": {"from": {"$ref": "#/definitions/id"}, "to": {"$ref": "#/definitions/id"}, "kind": {"enum": ["recommended", "prerequisite"]}, "label": {"$ref": "#/definitions/text"}, "basis": {"$ref": "#/definitions/text"}}
    }}
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"}
  }
}
