{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:diagram-design-system:presentation-package:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "presentationId",
    "presentationVersion",
    "generatedAt",
    "slides",
    "sources",
    "formats",
    "font",
    "ruleHashes",
    "dependencyHash",
    "status",
    "codeFont"
  ],
  "properties": {
    "schemaVersion": {
      "const": "presentation-package-1.0"
    },
    "presentationId": {
      "type": "string",
      "minLength": 1
    },
    "presentationVersion": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pageId",
          "slideId",
          "slideVersion",
          "part",
          "templateId",
          "contentHash",
          "sourceReferences",
          "generatedAt",
          "artifacts"
        ],
        "properties": {
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "slideId": {
            "type": "string",
            "minLength": 1
          },
          "slideVersion": {
            "type": "integer",
            "minimum": 1
          },
          "part": {
            "type": "integer",
            "minimum": 1
          },
          "templateId": {
            "type": "string",
            "minLength": 1
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId",
                "sourceVersion",
                "locator"
              ],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string"
                }
              }
            }
          },
          "generatedAt": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sizeBytes",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sourceVersion",
          "path",
          "sha256"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "svg",
        "png",
        "thumbnailPng",
        "pdf",
        "pptx",
        "webSvg",
        "webp"
      ],
      "properties": {
        "svg": {
          "enum": [
            "generated",
            "unsupported"
          ]
        },
        "png": {
          "enum": [
            "generated",
            "unsupported"
          ]
        },
        "thumbnailPng": {
          "enum": [
            "generated",
            "unsupported"
          ]
        },
        "pdf": {
          "enum": [
            "generated",
            "unsupported",
            "not_requested"
          ]
        },
        "pptx": {
          "enum": [
            "generated",
            "unsupported",
            "not_requested"
          ]
        },
        "webSvg": {
          "enum": [
            "generated",
            "unsupported"
          ]
        },
        "webp": {
          "enum": [
            "generated",
            "unsupported"
          ]
        }
      }
    },
    "font": {
      "type": "object"
    },
    "ruleHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "dependencyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "generated"
    },
    "codeFont": {
      "type": "object"
    },
    "deckArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sizeBytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
